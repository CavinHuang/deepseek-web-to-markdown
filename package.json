{
  "name": "deepseek-web-to-markdown",
  "private": true,
  "version": "1.0.0",
  "description": "A local-first web-to-Markdown workspace powered by the DeepSeek Fetch API.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "node --input-type=module -e \"process.env.SERVE_STATIC='true'; await import('./server/index.mjs')\"",
    "typecheck": "tsc -b --pretty",
    "test": "node --test"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "concurrently": "^9.1.2"
  }
}
