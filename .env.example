# Production web/API port (inside the container)
PORT=4173

# Docker Compose host port (defaults to 4173)
APP_PORT=4173

# Trusted HTTPS DeepSeek-compatible Fetch endpoint
DEEPSEEK_FETCH_ENDPOINT=https://api.deepseek.com/v1/tools/fetch

# API rate limit: requests per client within the configured window
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=600000

# Persistent cache for successful Fetch responses (mount /app/data in Docker/Dokploy)
URL_CACHE_DIR=./data/url-cache
URL_CACHE_MEMORY_ENTRIES=128

# Comma-separated frontend origins when frontend and API are deployed separately
# Example: ALLOWED_ORIGINS=https://your-frontend.example.com
ALLOWED_ORIGINS=

# Set true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
